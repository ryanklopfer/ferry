{
  "$schema": "ferry-design-tokens/v1",
  "brand": "Ferry",
  "color": {
    "cream":   { "value": "#FFF6EC", "role": "App background" },
    "white":   { "value": "#FFFFFF", "role": "Cards, sheets, nav bar" },
    "peach":   { "value": "#F0704F", "role": "Primary action fill, boat hull. Always navy text on it." },
    "blush":   { "value": "#FFD9C2", "role": "Secondary fill, chips, input borders, pending state" },
    "sea":     { "value": "#2EA88F", "role": "Progress, money, success fills" },
    "seaDeep": { "value": "#176D5C", "role": "Money and success TEXT on light backgrounds" },
    "mint":    { "value": "#E5F5F0", "role": "Success/info tint behind seaDeep text" },
    "navy":    { "value": "#17263F", "role": "Primary text, icons, links, wave stroke, camera screen background" },
    "navySurface": { "value": "#24375A", "role": "Raised surfaces on the navy camera screen" },
    "slate":   { "value": "#566680", "role": "Secondary text, captions, inactive nav" },
    "mist":    { "value": "#EEF1F6", "role": "Neutral tint (e.g. 'not like' examples, disabled fills)" },
    "onNavyText":  { "value": "#C7D2E6", "role": "Secondary text on navy" },
    "onNavyMuted": { "value": "#93A3BD", "role": "Placeholder text on navy" },
    "danger":  { "value": "#C43D2E", "role": "Errors only. Never for money." }
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "fallback": "'Helvetica Neue', Arial, sans-serif", "weights": [600, 800], "google": "Bricolage+Grotesque:wght@600;800" },
    "body":    { "family": "Figtree", "fallback": "'Helvetica Neue', Arial, sans-serif", "weights": [400, 500, 600, 700], "google": "Figtree:wght@400;500;600;700" }
  },
  "type": {
    "hero":     { "font": "display", "size": 44, "weight": 800, "lineHeight": 1.0,  "tracking": "-0.03em" },
    "h1":       { "font": "display", "size": 30, "weight": 800, "lineHeight": 1.05, "tracking": "-0.02em" },
    "h2":       { "font": "display", "size": 24, "weight": 800, "lineHeight": 1.1,  "tracking": "-0.02em" },
    "h3":       { "font": "display", "size": 22, "weight": 800, "lineHeight": 1.15, "tracking": "-0.01em" },
    "amount":   { "font": "display", "size": 36, "weight": 800, "lineHeight": 1.0,  "tracking": "-0.03em" },
    "body":     { "font": "body", "size": 16, "weight": 400, "lineHeight": 1.55 },
    "bodyStrong": { "font": "body", "size": 16, "weight": 700, "lineHeight": 1.4 },
    "secondary":{ "font": "body", "size": 15, "weight": 400, "lineHeight": 1.5 },
    "caption":  { "font": "body", "size": 13, "weight": 400, "lineHeight": 1.45 },
    "label":    { "font": "body", "size": 13, "weight": 700, "lineHeight": 1.3 },
    "chip":     { "font": "body", "size": 12, "weight": 700, "lineHeight": 1.2 },
    "button":   { "font": "body", "size": 17, "weight": 700, "lineHeight": 1.0 },
    "buttonSmall": { "font": "body", "size": 15, "weight": 700, "lineHeight": 1.0 }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "7": 32, "8": 40, "screenGutter": 20, "screenTop": 60, "screenBottom": 24 },
  "radius": { "chip": 999, "button": 999, "input": 16, "cardSmall": 22, "card": 28, "appIcon": 24 },
  "size": { "touchTarget": 44, "buttonPrimary": 60, "buttonSecondary": 56, "buttonTertiary": 48, "input": 48, "navBar": 64, "navItem": 48, "progressBar": 8, "shutter": 80 },
  "border": { "input": "2px solid {color.blush}", "cameraFrame": "2px dashed {color.slate}", "shutterRing": "6px solid {color.cream}" },
  "icon": { "size": 22, "sizeNav": 20, "strokeWidth": 2.2, "linecap": "round", "linejoin": "round", "style": "outline" },
  "shadow": { "none": "none" },
  "motion": {
    "tap":     { "duration": 120, "easing": "ease-out",  "scale": 0.97 },
    "sheet":   { "duration": 260, "easing": "cubic-bezier(0.2, 0.8, 0.2, 1)" },
    "progress":{ "duration": 400, "easing": "ease-in-out" },
    "wave":    { "duration": 1800, "easing": "ease-in-out", "note": "The wave under the boat may animate; the boat never tilts." }
  }
}
