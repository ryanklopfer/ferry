# Required for AI superbill reading and tailored follow-up letters. Without it the app
# still works: you enter codes manually and letters come from built-in templates.
ANTHROPIC_API_KEY=
# The direct API is allowed only for declared synthetic data in the dev tier. Unset counts as real.
FERRY_DATA_CLASS=synthetic
# Optional override
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Postgres. Homebrew's postgresql@17 accepts your macOS user with no password on localhost.
DATABASE_URL=postgres://localhost:5432/ferry_dev
# Optional; tests default to this value.
# DATABASE_URL_TEST=postgres://localhost:5432/ferry_test

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
