# Direct Anthropic API, for synthetic data in the dev tier only. Nothing calls it until S4.
ANTHROPIC_API_KEY=
# The direct API is allowed only for declared synthetic data in the dev tier. Unset counts as real.
FERRY_DATA_CLASS=synthetic
# Optional override
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Postgres. Homebrew's postgresql@17 accepts your macOS user with no password on localhost.
DATABASE_URL=postgres://localhost:5432/ferry_dev
# Optional; tests default to this value.
# DATABASE_URL_TEST=postgres://localhost:5432/ferry_test

# Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Capture relay (`bun run relay`). The web app signs 60-second relay tokens with the same secret.
# Generate with: openssl rand -base64 32
RELAY_SECRET=
RELAY_PORT=3001

# Phone spike (N3b). `bun run dev:phone` sets both for its own processes; leave them unset here.
# FERRY_SPIKE_K is the per-run key the /dev pages require (dev tier only). FERRY_RELAY_URL points the
# browser at a relay on another origin (the e2e suite); unset, it uses /ws/ on the page's own origin.
# FERRY_SPIKE_K=
# FERRY_RELAY_URL=

# Public pages only (the homepage, /for-clients, /legal/*): 1 turns it on in any tier, and the prelaunch tier
# implies it. Boot refuses any value but 0 or 1. Leave it unset for local development.
# FERRY_PRELAUNCH=
